# Service tier — environment variables (reference implementation).
# Load with:  set -a; . service_tier/env.example; set +a
# (named without the leading dot on purpose: `.env*` files are git-ignored and never published)

# --- Authentication ---
# Static API keys for the scan/job endpoints (comma separated). Empty = auth off
# (only for local use; the production service issues per-client keys from the
# api_keys table instead).
API_KEYS=local-dev-key
# Token for the scan-retrieval endpoints under /admin. Empty = those endpoints off.
ADMIN_TOKEN=local-admin-token

# --- PostgreSQL (local container, see docker-compose.example.yml) ---
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=refimpl
PGUSER=postgres
PGPASSWORD=change-me
PG_MIN_CONN=1
PG_MAX_CONN=8

# --- Verdict cache (Section 7, "Cache Coherence Across Changes") ---
CACHE_ENABLED=1
CACHE_TTL_DAYS=7

# --- Job queue (Section 7, "Queue Durability and Failure Isolation") ---
JOB_WORKERS=1
MAX_BATCH_ITEMS=500      # blocking variant (?wait=true): "at most a few hundred items"
MAX_JOB_ITEMS=50000

# --- Decision engine ---
# The compiled engine's address, or the engine shim:
#   python -m service_tier.tools.engine_shim --addr 127.0.0.1:8390
GOSCAN_URL=http://127.0.0.1:8390
GOSCAN_TIMEOUT_SECONDS=900
WARM_MODEL_ON_STARTUP=1

# --- Feed maintenance scheduler (no feed modules are registered in this package) ---
CVE_SYNC_INTERVAL_HOURS=0
CVE_SYNC_ON_STARTUP=0
